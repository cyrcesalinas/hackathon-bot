APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEZONE=America/Mexico_City

# Use a TNS alias from the extracted ADB wallet, normally the low service.
ADB_USER=
ADB_PASSWORD=
ADB_CONNECT_STRING=discordadb_low
ADB_WALLET_DIR=/home/opc/discord-example-app/wallet
ADB_WALLET_PASSWORD=
# Separate profile-store account; grant it DML only on AGENT_PROFILES.
AGENT_STORE_USER=
AGENT_STORE_PASSWORD=
AGENT_STORE_OWNER=
# /db scan and lookup auto-approve all supported columns in this schema.
ADB_CATALOG_OWNER=
# Optional. If both access settings are blank, only server administrators can use /db.
ADB_ALLOWED_GUILD_ID=
# Optional, comma-separated role IDs. A configured guild with no roles allows its members.
ADB_ALLOWED_ROLE_IDS=
