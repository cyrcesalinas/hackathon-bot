APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
# Optional HTTP port; defaults to 3000.
PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional timezone for OpenRouter's datetime tool.
OPENROUTER_DATETIME_TIMEZONE=America/New_York
# Optional model override for the /study slash commands; defaults to OPENROUTER_MODEL.
OPENROUTER_STUDY_MODEL=
# Agent requests deny data-collecting providers by default. Set to allow only after reviewing the provider policy.
OPENROUTER_AGENT_DATA_COLLECTION=deny

# Use a TNS alias from the extracted ADB wallet, normally the low service.
ADB_USER=
ADB_PASSWORD=
ADB_CONNECT_STRING=discordadb_low
ADB_WALLET_DIR=/home/opc/discord-example-app/wallet
ADB_WALLET_PASSWORD=
# Optional dedicated profile-store account; recommended for production.
# If omitted, the bot uses ADB_USER and ADB_PASSWORD.
AGENT_STORE_USER=
AGENT_STORE_PASSWORD=
# Optional. Defaults to ADB_USER. Set this when another schema owns AGENT_PROFILES.
AGENT_STORE_OWNER=
# /db scan and lookup auto-approve all supported columns in this schema.
ADB_CATALOG_OWNER=
