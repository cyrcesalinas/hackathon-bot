APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
# Optional HTTP port; defaults to 3000.
PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional timezone for OpenRouter's datetime tool.
OPENROUTER_DATETIME_TIMEZONE=America/New_York
# /study commands use OPENROUTER_MODEL like all other requests.
# Use a TNS alias from the extracted ADB wallet, normally the low service.
ADB_USER=
ADB_PASSWORD=
ADB_CONNECT_STRING=discordadb_low
ADB_WALLET_DIR=/home/opc/discord-example-app/wallet
ADB_WALLET_PASSWORD=
# Optional schema owner. Defaults to ADB_USER.
AGENT_STORE_OWNER=
# /db scan and lookup auto-approve all supported columns in this schema.
ADB_CATALOG_OWNER=

# Model-initiated personal notes, isolated by Discord user/server/channel.
# Install with npm run memory:setup and verify with npm run memory:check.
# Optional schema owner. Defaults to AGENT_STORE_OWNER or ADB_USER.
USER_MEMORY_OWNER=
