APP_ID=
DISCORD_TOKEN=
PUBLIC_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEZONE=America/Mexico_City

# Use a TNS alias from the extracted ADB wallet, normally the low service.
ADB_USER=
ADB_PASSWORD=
ADB_CONNECT_STRING=discordadb_low
ADB_WALLET_DIR=/home/opc/discord-example-app/wallet
ADB_WALLET_PASSWORD=
# Optional dedicated profile-store account; recommended for production.
# If omitted, the bot uses ADB_USER and ADB_PASSWORD.
AGENT_STORE_USER=
AGENT_STORE_PASSWORD=
# Optional. Defaults to the resolved agent-store user. Set this when another schema owns AGENT_PROFILES.
AGENT_STORE_OWNER=
# /db scan and lookup auto-approve all supported columns in this schema.
ADB_CATALOG_OWNER=
