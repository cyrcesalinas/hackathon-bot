{
  "name": "hackathon-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord learning assistant powered by OpenRouter and Oracle Database",
  "main": "app.js",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node app.js",
    "register": "node commands.js",
    "memory:agent-check": "node scripts/check-memory-agent.js",
    "test": "node --test",
    "deploy": "npm run register && sudo systemctl restart discord-example.service",
    "dev": "node --watch app.js",
    "tunnel": "./bin/ngrok http 3000"
  },
  "license": "MIT",
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "discord.js": "14.28.1",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "oracledb": "^26.0.0"
  }
}
