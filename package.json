{
  "name": "hackathon-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord learning assistant powered by OpenRouter and Oracle Database",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "start": "node app.js",
    "register": "node commands.js",
    "memory:setup": "node scripts/setup-user-memory.js",
    "memory:check": "node scripts/check-user-memory.js",
    "memory:agent-check": "node scripts/check-memory-agent.js",
    "test": "node --test",
    "deploy": "npm run register && sudo systemctl restart discord-example.service",
    "dev": "nodemon app.js",
    "tunnel": "./bin/ngrok http 3000"
  },
  "license": "MIT",
  "dependencies": {
    "discord-interactions": "^4.0.0",
    "discord.js": "14.27.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "oracledb": "^26.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0"
  }
}
